PORT=4000
MONGODB_URI=mongodb://localhost:27017/ovrload
# Optional: database name when MONGODB_URI has none (e.g. Railway ${{MongoDB.MONGO_URL}})
# MONGODB_DB=ovrload
CORS_ORIGIN=http://localhost:5173
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
# Proxy hops in front of the API (production image sets 1 = web nginx)
# TRUST_PROXY=1
